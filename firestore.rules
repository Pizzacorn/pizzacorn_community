rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCommunityOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function changesOneCounter() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount',
          'commentsCount',
          'repostCount',
          'updatedAt'
        ])
        && (
          (
            request.resource.data.likesCount != resource.data.likesCount
            && request.resource.data.likesCount in [
              resource.data.likesCount + 1,
              resource.data.likesCount - 1
            ]
          )
          || (
            request.resource.data.commentsCount != resource.data.commentsCount
            && request.resource.data.commentsCount in [
              resource.data.commentsCount + 1,
              resource.data.commentsCount - 1
            ]
          )
          || (
            request.resource.data.repostCount != resource.data.repostCount
            && request.resource.data.repostCount in [
              resource.data.repostCount + 1,
              resource.data.repostCount - 1
            ]
          )
        )
        && (
          request.resource.data.updatedAt == resource.data.updatedAt
          || request.resource.data.updatedAt == request.time
        );
    }

    function pollPath(postId) {
      return /databases/$(database)/documents/Community/$(postId);
    }

    function votePath(postId, userId) {
      return /databases/$(database)/documents/Community/$(postId)/Votes/$(userId);
    }

    function pollCountAt(data, index) {
      return index < data.pollCounts.size() ? data.pollCounts[index] : 0;
    }

    function validPollDelta(before, after, oldOption, newOption) {
      return before.pollOptions is list
        && before.pollCounts is list
        && after.pollOptions == before.pollOptions
        && after.pollCounts is list
        && after.pollCounts.size() == before.pollOptions.size()
        && before.pollOptions.size() >= 2
        && before.pollOptions.size() <= 4
        && newOption is int
        && newOption >= 0
        && newOption < before.pollOptions.size()
        && (
          oldOption == -1
          || (oldOption is int && oldOption >= 0
            && oldOption < before.pollOptions.size()
            && oldOption != newOption)
        )
        && pollDeltaAt(before, after, oldOption, newOption, 0)
        && pollDeltaAt(before, after, oldOption, newOption, 1)
        && pollDeltaAt(before, after, oldOption, newOption, 2)
        && pollDeltaAt(before, after, oldOption, newOption, 3);
    }

    function pollDeltaAt(before, after, oldOption, newOption, index) {
      return index >= before.pollOptions.size()
        || pollCountAt(after, index) == pollCountAt(before, index)
          + (index == newOption ? 1 : 0)
          - (index == oldOption ? 1 : 0);
    }

    function changesPoll(postId) {
      let path = votePath(postId, request.auth.uid);
      let oldOption = exists(path) ? get(path).data.optionIndex : -1;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollCounts'])
        && existsAfter(path)
        && getAfter(path).data.userId == request.auth.uid
        && validPollDelta(resource.data, request.resource.data,
          oldOption, getAfter(path).data.optionIndex);
    }

    function validVote(postId, userId, oldOption) {
      let path = pollPath(postId);
      return userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'optionIndex', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && exists(path)
        && existsAfter(path)
        && validPollDelta(get(path).data, getAfter(path).data,
          oldOption, request.resource.data.optionIndex);
    }

    // El plugin no debe leer ni escribir Firestore directamente.
    // Todas las operaciones sensibles pasan por Cloud Functions con Admin SDK.
    match /wordpressPluginSites/{siteId} {
      allow read, write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /wordpressPluginUsage/{usageId} {
      allow read, write: if false;
    }

    match /wordpressGenerationLogs/{logId} {
      allow read, write: if false;
    }

    match /wordpressGenerator/{document=**} {
      allow read, write: if false;
    }

    match /Temas/{topicId} {
      allow read, write: if false;
    }

    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Comunidad: usuarios autenticados pueden leer el muro.
    // Solo el autor puede editar o borrar su publicación.
    match /Community/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == postId
        && request.resource.data.type in ['post', 'comment', 'quote', 'repost']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.pollOptions is list
        && request.resource.data.pollCounts is list
        && request.resource.data.pollOptions.size() == request.resource.data.pollCounts.size()
        && request.resource.data.pollOptions.size() <= 4;
      allow update: if (
          isCommunityOwner()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.pollOptions == resource.data.pollOptions
          && request.resource.data.pollCounts == resource.data.pollCounts
        ) || (isSignedIn() && changesOneCounter())
          || (isSignedIn() && changesPoll(postId));
      allow delete: if isCommunityOwner();

      match /Likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn() && userId == request.auth.uid;
        allow update: if false;
      }

      match /Reposts/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type == 'repost'
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn() && userId == request.auth.uid;
        allow update: if false;
      }

      match /Votes/{userId} {
        allow get: if isSignedIn() && userId == request.auth.uid;
        allow list, delete: if false;
        allow create: if isSignedIn() && validVote(postId, userId, -1);
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && validVote(postId, userId, resource.data.optionIndex);
      }
    }

    // Los reportes se pueden enviar, pero solo los administra el backend.
    match /Reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reportId
        && request.resource.data.reason is string
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Fallback estricto. Si este Firestore se comparte con otras apps,
    // mueve sus reglas especificas encima de este bloque antes de desplegar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
